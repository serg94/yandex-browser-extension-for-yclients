{
  "manifest_version": 3,
  "name": "YClients: Hide Yandex Maps Comments",
  "version": "1.3.0",
  "description": "Hides 'Запись создана через Яндекс.Карты' comments, shows a 'new: N' records counter, and highlights on hover.",
  "permissions": [],
  "host_permissions": [
    "*://yclients.com/timetable/*",
    "*://*.yclients.com/timetable/*",
    "*://yclients.ru/timetable/*",
    "*://*.yclients.ru/timetable/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://yclients.com/timetable/*",
        "*://*.yclients.com/timetable/*",
        "*://yclients.ru/timetable/*",
        "*://*.yclients.ru/timetable/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
